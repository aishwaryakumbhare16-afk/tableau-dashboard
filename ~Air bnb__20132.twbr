      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_1531668625469441]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Pricing Categories' datatype='string' name='[Calculation_1531668626644994]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot;Luxary&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;Satandard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Category' datatype='string' name='[Calculation_1531668628070403]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_1531668628992004]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;=TODAY() THEN &quot;Active Status&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1531668632465415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1531668630540294] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;below Limit&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
